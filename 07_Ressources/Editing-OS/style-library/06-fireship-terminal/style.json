{
  "$schema": "../registry.schema.json",
  "id": "fireship-terminal",
  "name": "Fireship Terminal",
  "number": "06",
  "status": "draft",
  "inspiration": "Fireship dev-explainer. Near-black stage, cream Luckiest-Guy captions with fat black outlines stamping in word by word, JetBrains Mono code panels with pastel syntax colors and traffic-dot window chrome, neon wireframe title frames, flame-orange energy, meme-speed percussive pacing. Reference frames in references/.",
  "summary": "The fast, funny, technical style. Use for AI/tool tutorials, news-style updates, and any content where dev credibility plus punchy humor carries the edit.",
  "palette": {
    "bg": "#0B0B0F",
    "fg": "#E8E6DF",
    "accent": "#37BDF8",
    "cream": "#F4EFE2",
    "flame": "#FF6A2B",
    "synPink": "#F471B5",
    "synGreen": "#A3E635",
    "synPurple": "#A78BFA",
    "notes": "Captions are always cream with black stroke. brand blue is hero syntax + neon. Flame orange is the energy hit. Syntax pastels live only inside code panels and chips. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Luckiest Guy",
    "body": "Inter",
    "mono": "JetBrains Mono",
    "notes": "Luckiest Guy ALL CAPS with -webkit-text-stroke black rim (paint-order: stroke fill) is the caption voice. JetBrains Mono is all code/labels. Inter is rare supporting copy."
  },
  "motion": "Percussive. Captions STAMP in (scale 1.6-to-1, back.out(2.2), ~0.28s) word by word or row by row; code types on linearly with a blinking cursor (finite); neon frames flicker on; panels snap with expo.out. Dead stillness between hits - no drifts, no breathing.",
  "transitions": "Hard snap cuts and stamp-overlaps; a flame-gradient bar can wipe across. Never soft dissolves, never floaty whips.",
