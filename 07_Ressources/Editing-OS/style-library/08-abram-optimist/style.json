{
  "$schema": "../registry.schema.json",
  "id": "abram-optimist",
  "name": "Abram Optimist",
  "number": "08",
  "status": "draft",
  "inspiration": "Cleo-Abram bright tech optimism (Huge If True). Warm off-white canvas, big friendly Manrope 800 type, one prismatic gradient moment per card, springy pop entrances, light-leak flare sweeps, Space Mono tape-deck tags (REWIND <<). Reference frames in references/.",
  "summary": "The bright, energetic style. Use for optimistic tech explainers, product wins, and member-success stories — anywhere the future should feel exciting rather than ominous.",
  "palette": {
    "bg": "#FAFAF7",
    "fg": "#16161A",
    "accent": "#37BDF8",
    "prismPink": "#FF4D9D",
    "prismOrange": "#FF9A3D",
    "prismViolet": "#8B5CF6",
    "sun": "#FFD449",
    "notes": "Light canvas always. Prism colors exist only inside the --prism gradient / wash / flare; solo accents are brand blue; sun yellow for tiny marks. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Manrope",
    "body": "Inter",
    "mono": "Space Mono",
    "notes": "Manrope 700-800 sentence-case headlines and numbers; Inter supporting copy; Space Mono uppercase tape-deck tags in pill chips."
  },
  "motion": "Springy optimism. Pops (scale 0.6-to-1, back.out(1.7)) for chips and numbers; headlines rise-and-settle with expo.out; the prism gradient pans once; a light-leak flare sweeps the frame at the peak moment; eager count-ups. Pops land and stop - no continuous wobble.",
  "transitions": "The flare sweep (skewed bright band crossing the frame) and quick white dissolves. Never dark whips, never hard cuts.",
