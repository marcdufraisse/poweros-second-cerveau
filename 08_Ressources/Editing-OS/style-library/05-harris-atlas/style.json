{
  "$schema": "../registry.schema.json",
  "id": "harris-atlas",
  "name": "Harris Atlas",
  "number": "05",
  "status": "draft",
  "inspiration": "Johnny-Harris cinematic map journalism. Aged parchment maps, sage oceans, slate country fills with white boxed Oswald labels, one blue-highlighted region per beat, typewriter metadata, film grain + warm burn transitions, slow documentary push-ins. Reference frames in references/.",
  "summary": "The investigative atlas style. Use for story-driven explainers, history/geopolitics framing, and journeys — anything that benefits from dossier weight and cartographic storytelling.",
  "palette": {
    "bg": "#E7DDC4",
    "fg": "#2A241C",
    "accent": "#37BDF8",
    "sage": "#C2CDB4",
    "slate": "#57646A",
    "film": "#14110C",
    "red": "#BE3B2B",
    "notes": "Two grounds: parchment/sage paper with warm ink, and projector-black film with cream text. brand blue highlights the one hero region/word; red is conflict punctuation only. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Oswald",
    "body": "Source Serif 4",
    "mono": "Courier Prime",
    "notes": "Oswald condensed caps is the cartographic voice (boxed labels, dates, headlines); Source Serif 4 is the narrative voice; Courier Prime is archival metadata."
  },
  "motion": "Documentary weight. Slow background push-ins (camera rides the ground layer only), labels stamp in with expo.out, route lines draw, Courier text types on, film-ground cards flicker faintly (finite). Never springy, never choppy.",
  "transitions": "Warm film-burn washes sweeping the frame; paper cards can slide as plates. Never hard cuts, never whips.",
