{
  "$schema": "../registry.schema.json",
  "id": "keynote-minimal",
  "name": "Keynote Minimal",
  "number": "04",
  "status": "draft",
  "inspiration": "Apple product-film / keynote graphics. True-black stage, enormous tight grotesk type (white or metallic gradient), one soft light source per beat, hairline dividers, silky expo motion, radical negative space. Reference frames in references/ (iPhone 17 Pro film, MacBook reveal).",
  "summary": "The premium restraint style. Use for certification-course content, product-grade claims, and any video that should feel expensive and confident — one idea per beat, huge type, silence around it.",
  "palette": {
    "bg": "#000000",
    "fg": "#F5F5F7",
    "accent": "#37BDF8",
    "copper": "#E8804C",
    "violet": "#7D5CFF",
    "notes": "Black + white carry 90% of the frame. brand blue is the single functional accent (one element per card). Copper/violet live only inside gradients and glows. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Inter Tight",
    "body": "Inter",
    "mono": "IBM Plex Mono",
    "notes": "Inter Tight 600-800 with -0.035em tracking is the SF Pro stand-in (headlines, numbers). Inter is quiet supporting copy. IBM Plex Mono is spec metadata only."
  },
  "motion": "Silk. expo.out / power3.out entrances ~1.1s with a blur-resolve; slow sine.inOut glow breathing; silky count-ups. No bounce, no overshoot, no whips (those belong to other styles).",
  "transitions": "Cross-dissolves and hairline draws. Internal state changes dissolve; nothing wipes or whips.",
