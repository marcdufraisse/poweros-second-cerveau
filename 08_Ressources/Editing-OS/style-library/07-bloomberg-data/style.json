{
  "$schema": "../registry.schema.json",
  "id": "bloomberg-data",
  "name": "Bloomberg Data",
  "number": "07",
  "status": "draft",
  "inspiration": "Bloomberg-Originals brutalist data journalism. Stark black canvas, white Archivo-Narrow caps in label boxes with accent underline bars, thin broadsheet rules, terminal-amber mono numerals, market green/red deltas, precise square-cornered chart geometry. Reference frames in references/.",
  "summary": "The serious data/business voice. Use for market-style claims, numbers-heavy arguments, rankings, and anything that should feel like financial journalism rather than marketing.",
  "palette": {
    "bg": "#0A0A0A",
    "fg": "#F2F2F0",
    "accent": "#37BDF8",
    "amber": "#FFB020",
    "up": "#4AF6C3",
    "down": "#FF433D",
    "notes": "Flat fills only. Amber = numerals; blue = editorial accents (underline bars, chart keys); green/red = deltas exclusively. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Archivo",
    "body": "Archivo",
    "mono": "IBM Plex Mono",
    "notes": "Archivo 600-800 headlines; Archivo Narrow 600-700 UPPERCASE label boxes/kickers/axes; IBM Plex Mono for every numeral, ticker, delta, timestamp."
  },
  "motion": "Mechanical precision. Rules draw (scaleX, power3.inOut), label boxes clip-reveal with wipes, numbers roll up (power2.out), chart bars grow from the axis with staggers. No blur-ins, no springs, no ambience. End dead still.",
  "transitions": "Rule draws and hard wipes along the grid. Never dissolves, never whips.",
